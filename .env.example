# Canvas and card surfaces
THEME_CANVAS_BACKGROUND="#F5F2EC"
THEME_CARD_BACKGROUND="#FFFDF9"
THEME_MEDIA_BACKGROUND="#F3F6FA"
THEME_WHITE="#FFFFFF"

# Brand and typography colors
THEME_PRIMARY="#1557B0"
THEME_PRIMARY_SOFT="#E7EFFA"
THEME_TEXT="#142033"
THEME_MUTED_TEXT="#7D8794"

# Borders, dividers, and pattern fallback
THEME_BORDER="#1557B0"
THEME_ANSWER_BORDER="#6799CF"
THEME_DIVIDER="#B8CEE5"
THEME_PATTERN_FALLBACK="#6E91B8"

# Main-card shadows
THEME_SHADOW="rgba(22, 55, 94, 0.14)"
THEME_CONTACT_SHADOW="rgba(22, 55, 94, 0.07)"

# Locally bundled font family and static weights
FONT_FAMILY="Atkinson Hyperlegible Next"
FONT_REGULAR_PATH="assets/fonts/atkinson-hyperlegible-next/AtkinsonHyperlegibleNext-Regular.ttf"
FONT_MEDIUM_PATH="assets/fonts/atkinson-hyperlegible-next/AtkinsonHyperlegibleNext-Medium.ttf"
FONT_SEMIBOLD_PATH="assets/fonts/atkinson-hyperlegible-next/AtkinsonHyperlegibleNext-SemiBold.ttf"
FONT_BOLD_PATH="assets/fonts/atkinson-hyperlegible-next/AtkinsonHyperlegibleNext-Bold.ttf"

# Renderer-wide image assets
ASSET_OUTER_PATTERN="assets/patterns/fox-username-pattern.png"
ASSET_INNER_PATTERN="assets/patterns/card-inner-geometric-pattern.png"
ASSET_PAPER_TEXTURE="assets/patterns/paper-texture.svg"
ASSET_DIFFICULTY_SPRITE="assets/icons/fox-difficulty-sprite.png"
